# dependencies
# Unanchored so nested installs are ignored too — motion-ad/scripts and
# .agents/skills/motion-ad/scripts each carry their own node_modules.
/node_modules
node_modules/

# next.js
/.next/
/out/

# production
/build

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dev-server.log

# env files
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts